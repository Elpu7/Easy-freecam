{
  "schema_version": 1,
  "quilt_loader": {
    "group": "dev.elpu7",
    "id": "easy-freecam",
    "version": "${version}",
    "metadata": {
      "name": "Easy-freecam",
      "description": "A simple, easy-to-use Freecam mod.",
      "contributors": {
        "Elpu7": "Owner"
      },
      "contact": {
        "homepage": "https://modrinth.com/project/easy-freecam",
        "issues": "https://github.com/Elpu7/easy-freecam/issues",
        "sources": "https://github.com/Elpu7/easy-freecam"
      },
      "license": "MIT",
      "icon": "assets/easy-freecam/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "modmenu": "dev.elpu7.easyFreecam.quilt.compat.EasyFreecamModMenu"
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": "${quilt_loader_dependency}"
      },
      {
        "id": "elib",
        "versions": ">=${elib_version}"
      },
      {
        "id": "minecraft",
        "versions": "${minecraft_dependency}"
      },
      {
        "id": "java",
        "versions": ">=25"
      }
    ]
  },
  "minecraft": {
    "environment": "client"
  },
  "mixin": [
    "easy-freecam.mixins.json",
    "easy-freecam.client.mixins.json",
    "easy-freecam.quilt.mixins.json"
  ]
}
